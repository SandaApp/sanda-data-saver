<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/bg_card2"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_emoji"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="📖"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/filter_tab_active"
                android:padding="4dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scripture Reading"
                    android:textColor="@color/color_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Read the Word"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Message about distracting screen time"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_scripture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖 John 3:16 — For God so loved"
            android:textColor="@color/color_primary"
            android:textSize="11sp"
            android:textStyle="italic"
            android:background="@color/bg_secondary"
            android:padding="8dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Action"
            android:textColor="@color/color_success"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
