<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android=
        "http://schemas.android.com/apk/res/android"
    xmlns:app=
        "http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- ── Header ─────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_secondary"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/color_primary"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧹 Phone Cleaner"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            android:layout_marginStart="12dp"/>

    </LinearLayout>

    <!-- ── Storage Info Card ──────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/bg_secondary"
        app:strokeColor="@color/bg_tertiary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Storage Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💾 Storage"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <!-- Storage Numbers Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_used_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_accent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Used"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_free_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_success"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Free"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_total_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Storage Progress Bar -->
            <ProgressBar
                android:id="@+id/storage_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="0"
                android:max="100"
                android:progressTint="@color/color_accent"
                android:progressBackgroundTint="@color/bg_tertiary"/>

            <!-- Cleanable size -->
            <TextView
                android:id="@+id/tv_cleanable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculating cleanable space..."
                android:textSize="12sp"
                android:textColor="@color/color_success"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ── Clean Buttons ──────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:gravity="center">

        <!-- Quick Clean Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_clean"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="2"
            android:text="🚀 Quick Clean"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            app:backgroundTint="@color/color_success"
            app:cornerRadius="28dp"/>

        <!-- Analyze Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_analyze"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="🔍 Scan"
            android:textSize="13sp"
            app:backgroundTint="@color/bg_tertiary"
            app:cornerRadius="28dp"/>

    </LinearLayout>

    <!-- ── Progress Bar ───────────────── -->
    <ProgressBar
        android:id="@+id/clean_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:progressTint="@color/color_success"
        android:indeterminateTint="@color/color_success"/>

    <!-- ── Status Text ────────────────── -->
    <TextView
        android:id="@+id/tv_clean_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to clean your phone..."
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"/>

    <!-- ── Clean Log ──────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cleaning Log:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/color_primary"
        android:paddingStart="20dp"
        android:paddingBottom="4dp"/>

    <ScrollView
        android:id="@+id/scroll_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@color/bg_secondary"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/color_success"
            android:lineSpacingExtra="4dp"
            android:text="Tap Quick Clean to start.\n\nThis will safely remove:\n  • App cache files\n  • Thumbnail cache\n  • Leftover APK installers\n  • Temp and log files\n  • Empty folders"/>

    </ScrollView>

    <!-- ── Result Banner ─────────────── -->
    <LinearLayout
        android:id="@+id/result_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_secondary"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_success"
            android:gravity="center"/>

    </LinearLayout>

</LinearLayout>